# Exemple de configuration de la persistance DURABLE (app/persistence.py).
# Copier dans les secrets Streamlit Cloud (Settings > Secrets) ou dans
# .streamlit/secrets.toml en local (NE PAS COMMITER le vrai fichier).
#
# Table attendue côté Supabase/Postgres :
#   create table rondol_state (key text primary key, payload jsonb);
#
# Sans cette section, l'app fonctionne mais affiche :
#   "Persistent storage not configured — saved data may be lost after a
#    server reboot/redeploy."

[supabase]
url = "https://YOUR-PROJECT.supabase.co"
key = "YOUR-SERVICE-OR-ANON-KEY"
# table = "rondol_state"   # optionnel (défaut)

# Alternative hors cloud (volume monté / chemin réseau durable) :
# variable d'environnement RONDOL_EXTERNAL_STORE_PATH=/mnt/data/rondol_applied_state.json
